### Collect Max Thresholds

```{r}
collectMaxThresholdsCR <- function(file_path, model_type) {
  votes <- read.csv(here(paste0(file_path, "/rand_forest_votes.csv"))) %>%
    mutate(model = model_type)
  results <- read.csv(here(paste0(file_path, "/rand_forest_results.csv"))) %>%
    mutate(model = model_type)

  max_sens_spec <- votes$.threshold[which.min(abs(
    votes$specificity - votes$sensitivity
  ))]

  status_levels <- levels(as.factor(results$status)) # ensure levels of truth are known
  results_1 <- results %>%
    mutate(
      .pred_class_threshold_max_sens_spec = factor(
        ifelse(.pred_new > max_sens_spec, "new", "old"),
        levels = status_levels
      ),
      status = as.factor(status)
    )
  antibody_metrics <- yardstick::metric_set(
    roc_auc,
    sens,
    yardstick::spec,
    ppv,
    npv
  )
  sens_spec_metrics <- results_1 %>%
    antibody_metrics(
      truth = status,
      estimate = .pred_class_threshold_max_sens_spec,
      .pred_new
    ) %>%
    mutate(group = model_type)
  write.csv(
    sens_spec_metrics,
    here::here(paste0(
      file_path,
      "/rand_forest_sens_spec_performance_metrics.csv"
    )),
    row.names = F
  )

  return(sens_spec_metrics)
}

