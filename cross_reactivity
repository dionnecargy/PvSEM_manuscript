#### Get maximised threshold points for each curve 

```{r}
max_sens_spec_points <- sens_spec_all %>%
  group_by(group2) %>%
  filter(.metric == "sens" | .metric == "spec" | .metric == "roc_auc") %>%
  ungroup() %>%
  pivot_wider(
    names_from = ".metric",
    values_from = ".estimate"
  ) %>%
  mutate(
    sens_lab = round(sens * 100, 1),
    spec_lab = round(spec * 100, 1),
    label = paste0(sens_lab, "% sensitivity / ", spec_lab, "% specificity"),
    group_lab = case_when(
      group2 == "pv_8_antigen" ~ "Pv 8-antigen",
      group2 == "pf_reduced_1" ~ "Pf Reduced",
      group2 == "pf_reduced_2" ~ "Pf Reduced with PvRBP2b",
      group2 == "pk_reduced" ~ "Pk Reduced",
      group2 == "pm_reduced" ~ "Pm Reduced",
      .default = group2
    ),
    group = paste0(group_lab, " (AUC = ", round(roc_auc, 3), ")")
  ) %>%
  dplyr::select(group, group2, sens, spec, label)
```

