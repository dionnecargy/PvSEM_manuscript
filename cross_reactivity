# Load Packages and Data 

We will load in pre-defined packages from `packages.R` and read in our data frame `d_samples_global_training.csv` containing 2,635 samples from the longitudinal cohort studies and negative control donor sources. 

```{r}
# Source pre-defined R packages 
source(here::here("packages.R"))

# Load primary dataset
d <- read.csv(here::here("data/d_samples_global_training.csv"))

# Source pre-defined R functions 
r_files <- list.files(here::here("R"), pattern = "\\.R$", full.names = TRUE, ignore.case = TRUE)
invisible(lapply(r_files, function(f) source(f)))

d_folds <- vfold_cv(d, v = 10, repeats = 5, strata = status)
cores <- parallel::detectCores() - 1

# Antigen combinations
pf_reduced_antigens_1 <- c("LF005", "LF016", "MSP8") # removed MSP5
pf_reduced_antigens_2 <- c("LF005", "RBP2b.P87", "LF016", "MSP8") # removed MSP5
pk_reduced_antigens <- c("EBP", "LF010", "RBP2b.P87") # removed PvCSS and PTEX150
pm_reduced_antigens <- c("EBP", "PvCSS", "LF005", "LF010", "RBP2b.P87", "LF016") # removed MSP8

# Less conservative
pf_reduced_antigens_less1 <- c("LF005", "LF016", "MSP8", "PvCSS", "EBP")
pf_reduced_antigens_less2 <- c("LF005","LF016","MSP8","PvCSS","EBP","RBP2b.P87")
pm_reduced_antigens_less <- c("EBP", "PvCSS", "LF005", "LF010", "RBP2b.P87","LF016","MSP8")
pk_reduced_antigens_less <- c("EBP", "LF010", "RBP2b.P87", "PTEX150")
```

