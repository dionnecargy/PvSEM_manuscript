cross_reactivity_plot2 <- function(
  df,
  sens_spec_df,
  string_for_groups,
  lab1,
  lab2, # colour legend labels
  lab3,
  lab4, # fill legend labels
  colour2, # second colour
  plot_title
) {
  lab1 <- sens_spec_df %>%
    filter(group2 == string_for_groups[[2]]) %>%
    pull(label)
  lab2 <- sens_spec_df %>%
    filter(group2 == string_for_groups[[1]]) %>%
    pull(label)
  lab3 <- sens_spec_df %>%
    filter(group2 == string_for_groups[[2]]) %>%
    pull(group)
  lab4 <- sens_spec_df %>%
    filter(group2 == string_for_groups[[1]]) %>%
    pull(group)

  sens_spec_df_1 <- sens_spec_df %>%
    filter(group2 %in% string_for_groups) %>%
    mutate(
      label = factor(label, levels = unique(c(lab1, lab2))),
      group = factor(group, levels = unique(c(lab3, lab4)))
    )

  ggplot(df, aes(x = 1 - specificity, y = sensitivity, colour = group)) +

    # ROC points + lines
    geom_point(size = 0.15) +
    geom_line(linewidth = 1) +

    # Sensitivity/specificity maximised points
    geom_point(
      data = sens_spec_df_1,
      aes(x = 1 - spec, y = sens, fill = label),
      size = 3,
      shape = 21
    ) +

    # Diagonal reference line
    geom_abline(slope = 1, linetype = "dashed") +

    # Axes
    scale_y_continuous(breaks = seq(0, 1, 0.2)) +
    scale_x_continuous(breaks = seq(0, 1, 0.2)) +

    # Proper named manual colours
    scale_colour_manual(values = c("grey", colour2)) +
    scale_fill_manual(values = c("grey", colour2)) +

    # Labels
    labs(
      title = plot_title,
      x = "1 - Specificity",
      y = "Sensitivity",
      colour = "Pv Algorithm Type",
      fill = "Balanced sensitivity and specificity"
    ) +

    theme_bw() +

    guides(
      colour = guide_legend(
        override.aes = list(size = 3, linewidth = 1.5),
        order = 1
      ),
      fill = guide_legend(
        override.aes = list(size = 4),
        order = 2
      )
    ) +
    theme(
      legend.position = c(0.95, 0.05), # inside plot (normalized coordinates)
      legend.justification = c(1, 0), # anchor bottom-right corner
      legend.background = element_rect(
        fill = alpha("white", 0.8),
        colour = "black"
      ),
      legend.box.background = element_rect(colour = "black"),
      legend.box.margin = margin(2, 2, 2, 2)
    ) +
    coord_cartesian(clip = "off")
}

